% Project-local figure/table styling. Original CAS class and macro files are unchanged.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sgtg-floats}[2026/09/23 Faithful figure and table layout]
\RequirePackage{siunitx}
\RequirePackage{placeins}
% The format reserves SPACE, not added digits; input precision is never rounded/padded.
\newcommand{\SGTGnum}[1]{\tablenum[table-format=2.2,round-mode=none,
  round-pad=false,group-digits=none,detect-weight=true,detect-family=true,
  mode=text,table-number-alignment=center]{#1}}
\newcommand{\SGTGtableSetup}{%
  \small\setlength{\tabcolsep}{2.6pt}%
  \renewcommand{\arraystretch}{1.18}%
  \setlength{\heavyrulewidth}{0.8pt}%
  \setlength{\lightrulewidth}{0.4pt}%
  \setlength{\cmidrulewidth}{0.3pt}}
\setcounter{dbltopnumber}{2}
\renewcommand{\dbltopfraction}{0.88}
\renewcommand{\dblfloatpagefraction}{0.80}
\renewcommand{\textfraction}{0.08}
\setlength{\dbltextfloatsep}{12pt plus 2pt minus 2pt}
\setlength{\dblfloatsep}{10pt plus 2pt minus 2pt}
% Stage 7: venue/year labels and user-defined column-maximum emphasis.
\newcommand{\SGTGvenue}[1]{\mbox{\footnotesize\textbf{#1}}}
\endinput
